<launch>
  <arg name="output_dir" default="/tmp/nlp_latency_audit"/>

  <param name="/use_sim_time" value="false"/>
  <rosparam command="load" file="$(find forklift_map)/config/map_param.yaml"/>
  <rosparam command="load" file="$(find forklift_planner)/config/planner_param.yaml"/>
  <param name="/forklift_planner/random_seed" value="2022"/>
  <param name="/forklift_planner/multi_vehicle/vehicle_count" value="4"/>
  <param name="/forklift_planner/multi_vehicle/random_seed" value="2022"/>
  <param name="/forklift_planner/multi_vehicle/real_mode" value="false"/>

  <node pkg="forklift_planner" type="multi_vehicle_patrol_node"
        name="multi_vehicle_patrol_node" output="screen">
    <param name="debug_log_dir" value="$(arg output_dir)/diagnostics"/>
  </node>

  <node pkg="forklift_nlp_recovery" type="recovery_visualizer_node"
        name="forklift_nlp_recovery" output="screen">
    <rosparam command="load" file="$(find forklift_nlp_recovery)/config/recovery.yaml"/>
    <param name="mode" value="auto"/>
    <param name="execute_after_solve" value="true"/>
    <param name="results_dir" value="$(arg output_dir)/results"/>
    <param name="debug_output_file" value="$(arg output_dir)/latest_input.yaml"/>
  </node>
</launch>

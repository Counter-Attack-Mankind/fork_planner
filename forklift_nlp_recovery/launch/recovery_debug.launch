<launch>
  <!-- Complete A1 simulation + NLP recovery debugging in one command. -->
  <arg name="start_planner_rviz" default="true"/>
  <arg name="start_recovery_rviz" default="true"/>
  <arg name="one_shot" default="false"/>

  <!-- Reuse the map, planner, parameters and primary RViz from the normal simulation. -->
  <include file="$(find forklift_planner)/launch/multi_vehicle_a1_rviz.launch">
    <arg name="one_shot" value="$(arg one_shot)"/>
    <arg name="start_rviz" value="$(arg start_planner_rviz)"/>
  </include>

  <!-- Only the recovery-specific parameters and node are added here. -->
  <rosparam command="load"
            file="$(find forklift_nlp_recovery)/config/recovery.yaml"
            ns="/forklift_nlp_recovery"/>

  <node pkg="forklift_nlp_recovery"
        type="recovery_visualizer_node"
        name="forklift_nlp_recovery"
        output="screen"/>

  <node if="$(arg start_recovery_rviz)"
        pkg="rviz"
        type="rviz"
        name="recovery_debug_rviz"
        args="-d $(find forklift_nlp_recovery)/rviz/recovery_debug.rviz"
        required="false">
    <env name="LIBGL_ALWAYS_SOFTWARE" value="1"/>
    <env name="QT_X11_NO_MITSHM" value="1"/>
  </node>
</launch>

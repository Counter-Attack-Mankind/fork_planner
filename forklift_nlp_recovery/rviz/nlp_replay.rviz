Panels:
  - Class: rviz/Displays
    Name: Displays
  - Class: rviz/Views
    Name: Views
Visualization Manager:
  Class: ""
  Displays:
    - Alpha: 0.35
      Cell Size: 0.25
      Class: rviz/Grid
      Color: 100; 100; 100
      Enabled: true
      Name: Grid
      Plane: XY
      Plane Cell Count: 20
      Value: true
    - Class: rviz/MarkerArray
      Enabled: true
      Marker Topic: /forklift_nlp_recovery/replay_markers
      Name: NLP Offline Replay
      Queue Size: 10
      Value: true
  Enabled: true
  Global Options:
    Background Color: 24; 24; 28
    Default Light: true
    Fixed Frame: map
    Frame Rate: 50
  Name: root
  Tools:
    - Class: rviz/Interact
    - Class: rviz/MoveCamera
    - Class: rviz/Select
    - Class: rviz/FocusCamera
    - Class: rviz/Measure
  Views:
    Current:
      Class: rviz/Orbit
      Distance: 5.8
      Focal Point:
        X: 1.25
        Y: 2.25
        Z: 0
      Pitch: 1.5698
      Yaw: 4.71239
  Value: true
Window Geometry:
  Height: 900
  Width: 1450

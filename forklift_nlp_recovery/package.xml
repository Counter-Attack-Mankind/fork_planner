<?xml version="1.0"?>
<package format="2">
  <name>forklift_nlp_recovery</name>
  <version>0.1.0</version>
  <description>Read-only N-vehicle deadlock recovery trajectory optimization and visualization.</description>
  <maintainer email="yssun@hnu.edu.cn">Yueshuo Sun</maintainer>
  <license>MIT</license>

  <buildtool_depend>catkin</buildtool_depend>
  <depend>roscpp</depend>
  <depend>roslib</depend>
  <depend>geometry_msgs</depend>
  <depend>std_msgs</depend>
  <depend>std_srvs</depend>
  <depend>visualization_msgs</depend>
  <depend>forklift_map</depend>
  <depend>sandbox_msgs</depend>
  <depend>casadi</depend>
  <depend>yaml-cpp</depend>
  <exec_depend>roslaunch</exec_depend>
  <exec_depend>rviz</exec_depend>
  <test_depend>rostest</test_depend>
</package>
